# Amazon Bedrock Configuration (Converse API)
# Required for Amazon Bedrock Runtime calls in EcoPilot AI.
# If not provided, EcoPilot automatically activates its deterministic rule-based fallback.
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_SESSION_TOKEN="your_optional_session_token"
AWS_REGION="us-east-1"

# Bedrock Model ID (Supported examples:
# - anthropic.claude-3-5-sonnet-20241022-v2:0
# - anthropic.claude-3-haiku-20240307-v1:0
# - amazon.nova-micro-v1:0
# - meta.llama3-8b-instruct-v1:0
# - mistral.mistral-large-2407-v1:0)
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"

# FEATHERLESS_API_KEY: OpenAI-compatible AI provider for Featherless
# Get your API key from https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
